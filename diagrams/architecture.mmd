flowchart LR
  subgraph OFF["Off-chain (owner / member side)"]
    OWNER["Data owner<br/>(member client)"]
    PROVER["ZK prover<br/>zk-STARK proof + C = sha256(D)<br/>journal = C, min, max"]
    SIGNER["Binding signer (members)<br/>ECDSA over CBMSEP-BIND-v1 | key | C"]
  end

  subgraph MEM["Member organizations (Org1, Org2)"]
    CCD["Data chaincode CC_D<br/>endorsement OR(Org1, Org2)<br/>writes D to PDC, publishes C"]
    PDC[("Private Data Collection<br/>D private, C public commitment")]
  end

  subgraph NONMEM["Non-member organizations (Org3..Org5)"]
    CCV["Verification chaincode CC_V<br/>endorsement OutOf(2,3)<br/>no private-read API"]
    VER["STARK proof verifier<br/>WASM in wazero"]
    BND["Binding verifier<br/>ECDSA / pinned member CA roots<br/>requiredMembers = 2"]
  end

  CLIENT["Attestation client<br/>(non-member, Fabric Gateway)"]
  LEDGER[("Shared ledger / channel")]

  OWNER --> PROVER
  OWNER -->|TX1 SubmitData| CCD
  CCD --> PDC
  CCD -->|C public, status pending| LEDGER
  OWNER --> SIGNER
  PROVER -->|proof, journal| CLIENT
  SIGNER -->|sigma = member signatures| CLIENT
  CLIENT -->|TX2 Attest: key, C, sigma, proof, publicIn| CCV
  CCV --> VER
  CCV --> BND
  CCV -->|attestation committed| LEDGER
